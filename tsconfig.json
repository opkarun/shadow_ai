{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist"
  },
  "include": ["shared/**/*.ts", "detection/**/*.ts", "verification/**/*.ts", "communication/**/*.ts", "dashboard/**/*.ts", "dashboard/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
